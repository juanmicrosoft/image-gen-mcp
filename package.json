{
  "name": "@juanmicrosoft/image-gen-mcp",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Local MCP image generation and editing through your Azure deployment.",
  "type": "module",
  "bin": {
    "image-gen-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "assets/image-gen-mcp.png",
    "docs",
    "evaluation/briefs.json",
    "examples/copilot-cli.mcp.json",
    "examples/vscode.mcp.json",
    "examples/presentation/README.md",
    "examples/presentation/build.mjs",
    "examples/presentation/test.mjs",
    "examples/presentation/package.json",
    "examples/presentation/package-lock.json",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "AGENTS.md",
    "scripts/configure-client.mjs"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/juanmicrosoft/image-gen-mcp.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import ./test/fixtures/offline-fetch.mjs --test test/*.test.mjs",
    "prepack": "npm run build",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@azure/identity": "4.13.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  }
}
